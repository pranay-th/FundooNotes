# ── Production environment variables for Vercel ───────────────────────────────
# Set these in the Vercel dashboard under Project → Settings → Environment Variables
# rather than committing real values here.
#
# These are the Railway URLs you get after deploying each service.

VITE_DJANGO_API_URL=https://your-django-service.onrender.com
VITE_COLLAB_API_URL=https://your-collab-service.onrender.com
